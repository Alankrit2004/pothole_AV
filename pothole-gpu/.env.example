# Copy to .env and fill in real values. Never commit the real .env file.

# Required. App refuses to start without this.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Bootstrap admin account password. If unset, a random one-time password
# is generated and printed to the logs on startup.
ADMIN_PASSWORD=

# Comma-separated list of frontend origin(s) allowed to call this API.
# Never use "*" -- required for credentialed (Authorization header) requests.
CORS_ORIGINS=https://your-frontend.example.com

# Minimum password length enforced on /auth/register and /auth/change-password.
PASSWORD_MIN_LENGTH=10

# Optional: point at redis:// for multi-replica rate-limit sharing.
# Defaults to in-process memory, which is fine for the single-worker
# gthread deployment described in the Dockerfile.
RATELIMIT_STORAGE_URI=memory://

# Retention / cleanup tuning (seconds).
JOB_TTL_SECONDS=86400
OUTPUT_TTL_SECONDS=604800
RETENTION_SWEEP_INTERVAL_SECONDS=3600

LOG_LEVEL=INFO
